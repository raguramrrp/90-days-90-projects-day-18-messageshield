# TextVigil Configuration
# Copy this file to .env only if you want to override local defaults.
# The app runs 100% locally by default with zero external API keys required.

MS_APP_NAME=TextVigil
MS_HOST=127.0.0.1
MS_PORT=8000
MS_DB_PATH=data/messageshield.db
MS_MODEL_PATH=models/messageshield_models.joblib
MS_EVAL_PATH=models/evaluation_report.json
MS_RULES_PATH=config/threat_rules.json

# Optional Tesseract binary override (auto-detected on Windows if omitted)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Upload safety limits
MS_MAX_IMAGE_MB=10
MS_MAX_CSV_MB=5
MS_MAX_CSV_ROWS=1000
MS_MAX_MESSAGE_CHARS=2000

# Optional external URL reputation mode: "local_only" (default) or "virustotal"
MS_URL_REPUTATION_PROVIDER=local_only
# VIRUSTOTAL_API_KEY=
