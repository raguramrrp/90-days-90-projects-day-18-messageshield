    ],
    "brand_lookalike_targets": {
      "sbi": ["sbi.co.in", "onlinesbi.sbi", "sbi.bank.in"],
      "hdfc": ["hdfcbank.com"],
      "icici": ["icicibank.com"],
      "axis": ["axisbank.com"],
      "kotak": ["kotak.com"],
      "pnb": ["pnbindia.in"],
      "paytm": ["paytm.com"],
      "phonepe": ["phonepe.com"],
      "gpay": ["pay.google.com"],
      "npci": ["npci.org.in"],
      "bhim": ["bhimupi.org.in"],
      "indiapost": ["indiapost.gov.in"],
      "bluedart": ["bluedart.com"],
      "dtdc": ["dtdc.in"],
      "delhivery": ["delhivery.com"],
      "uidai": ["uidai.gov.in"],
      "epfo": ["epfindia.gov.in"],
      "incometax": ["incometax.gov.in"],
      "irctc": ["irctc.co.in"],
